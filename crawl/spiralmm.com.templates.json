  "findings": [
    {
      "code": "SITE-01",
      "severity": "major",
      "title": "11 pages show real content but answer 404: the site is served through its error page",
      "where": [
        {
          "url": "https://spiralmm.com/contact/",
          "says": "answered 404, drew \"Let's Build Something\""
        },
        {
          "url": "https://spiralmm.com/careers/",
          "says": "answered 404, drew \"Careers\""
        },
        {
          "url": "https://spiralmm.com/careers/ai-engineer-computer-vision/",
          "says": "answered 404, drew \"AI Engineer (Computer Vision)\""
        },
        {
          "url": "https://spiralmm.com/careers/nodejs-developer/",
          "says": "answered 404, drew \"Node.js Developer\""
        },
        {
          "url": "https://spiralmm.com/careers/uiux-designer/",
          "says": "answered 404, drew \"UI/UX Designer\""
        },
        {
          "url": "https://spiralmm.com/projects/",
          "says": "answered 404, drew \"Projects\""
        },
        {
          "url": "https://spiralmm.com/projects/siv/",
          "says": "answered 404, drew \"Members Only, By Design.\""
        },
        {
          "url": "https://spiralmm.com/careers/devops-engineer/",
          "says": "answered 404, drew \"DevOps Engineer\""
        },
        {
          "url": "https://spiralmm.com/careers/product-owner/",
          "says": "answered 404, drew \"Product Owner\""
        },
        {
          "url": "https://spiralmm.com/careers/nextjs-frontend-developer/",
          "says": "answered 404, drew \"Next.js Frontend Developer\""
        },
        {
          "url": "https://spiralmm.com/careers/react-native-developer/",
          "says": "answered 404, drew \"React Native Developer\""
        }
      ],
      "why": "A visitor sees each page, but search engines, link checkers and monitoring trust the status: they treat these pages as missing, so they may never appear in search results, and every check calls them broken.",
      "fix": "Serve each page with status 200: a single-page app behind a CDN usually needs its error response (the one that returns index.html) set to 200, or each route pre-rendered as its own file."
    },
    {
      "code": "SITE-33",
      "severity": "major",
      "title": "1 link to another site leads nowhere: the page is gone",
      "where": [
        {
          "url": "https://qsuremm.xyz/",
          "says": "its name no longer resolves: the site is gone; linked from /, /projects/"
        }
      ],
      "why": "Sites move and close: a visitor who follows one of these links meets an error page, or nothing at all, on someone else's site, and leaves thinking less of this one.",
      "fix": "Point each link at where the page lives now, or take it out. The suite's link report asks every one again on each run, and fails when one that answered stops."
    },
