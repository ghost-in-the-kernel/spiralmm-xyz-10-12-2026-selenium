  "findings": [
    {
      "code": "SITE-01",
      "severity": "major",
      "title": "11 pages show real content but answer 404: the site is served through its error page",
      "where": [
        {
          "url": "https://spiralmm.xyz/contact/",
          "says": "answered 404, drew \"Let's Build Something\""
        },
        {
          "url": "https://spiralmm.xyz/careers/",
          "says": "answered 404, drew \"Careers\""
        },
        {
