    {
      "code": "SITE-24",
      "severity": "minor",
      "title": "4 security headers no page sends",
      "where": [
        {
          "url": "https://spiralmm.xyz/",
          "says": "no page of the site sends Strict-Transport-Security (browsers keep to https)"
        },
        {
          "url": "https://spiralmm.xyz/",
          "says": "no page of the site sends Content-Security-Policy (which scripts may run)"
        },
        {
          "url": "https://spiralmm.xyz/",
          "says": "no page of the site sends X-Frame-Options or frame-ancestors (another site cannot frame it to trick a click)"
        },
        {
          "url": "https://spiralmm.xyz/",
          "says": "no page of the site sends X-Content-Type-Options: nosniff"
        }
      ],
      "why": "Each header closes a door attackers use (a downgrade to http, a script slipped in, the site framed in another to trick a click). Security reviews and compliance checklists ask for them, and they cost a line of server configuration.",
      "fix": "Add the missing headers in the web server or the CDN (one setting each), starting with Strict-Transport-Security."
    },
    {
      "code": "SITE-25",
      "severity": "minor",
      "title": "The server says which software and version it runs (AmazonS3)",
      "where": [
        {
          "url": "https://spiralmm.xyz/",
          "says": "server: AmazonS3"
        }
      ],
      "why": "A version number tells an attacker which known holes to try, without having to look; it helps no visitor.",
      "fix": "Turn off the version in the server's configuration (nginx: server_tokens off; Apache: ServerTokens Prod; PHP: expose_php = Off)."
    },
    {
      "code": "SITE-28",
      "severity": "minor",
      "title": "The site has no sitemap search engines can read",
      "where": [
        {
          "url": "https://spiralmm.xyz/sitemap.xml",
          "says": "answered 404"
        }
      ],
      "why": "A sitemap tells search engines every page to index, and how fresh each is; without one they find pages only by following links, and one listing wrong addresses spends their visits on errors.",
      "fix": "Publish /sitemap.xml listing each page's final address (most site builders and CMSs have a setting or plugin for it), and name it in robots.txt (Sitemap: ...)."
    },
    {
      "code": "SITE-29",
      "severity": "minor",
      "title": "The site has no security.txt: someone who finds a hole has no way to report it",
      "where": [
        {
          "url": "https://spiralmm.xyz/.well-known/security.txt",
          "says": "answered 404"
        }
      ],
      "why": "Researchers who find a security problem look for /.well-known/security.txt to know whom to tell (RFC 9116); without it they may not report it, or report it publicly.",
      "fix": "Publish /.well-known/security.txt with a Contact line (an email address or a form) and an Expires line."
    },
    {
      "code": "SITE-31",
      "severity": "minor",
      "title": "The site answers at two names, spiralmm.xyz and www.spiralmm.xyz, neither sending visitors to the other",
      "where": [
        {
          "url": "https://www.spiralmm.xyz/",
          "says": "answered 200 itself"
        }
      ],
      "why": "Search engines see every page twice, at two addresses, and split its ranking between them; links and shares point at both.",
      "fix": "Pick one name and redirect the other to it with a 301 (one setting in most hosts and CDNs): https://www.spiralmm.xyz/ to https://spiralmm.xyz/, say."
    }
  ],
